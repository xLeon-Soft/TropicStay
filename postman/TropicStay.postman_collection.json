        {
          "name": "30 - Confirmar Reserva (Anfitrión)",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{hostToken}}", "type": "string" }] },
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"confirmada\"\n}"
            },
            "url": "{{baseUrl}}/bookings/{{bookingId}}/status"
          }
        },
        {
          "name": "31 - Agregar Reseña al Chalet (Huésped)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Reseña creada en MongoDB', () => pm.response.to.have.status(201));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{guestToken}}", "type": "string" }] },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"rating\": 5,\n  \"comment\": \"Excelente vista al lago y atención inmediata del anfitrión.\",\n  \"cleanliness\": 5,\n  \"accuracy\": 5,\n  \"location\": 5,\n  \"communication\": 5,\n  \"value\": 5\n}"
            },
            "url": "{{baseUrl}}/chalets/{{chaletId}}/reviews"
          }
        },
        {
          "name": "32 - Cancelar Reserva (Huésped)",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{guestToken}}", "type": "string" }] },
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"cancelada\"\n}"
            },
            "url": "{{baseUrl}}/bookings/{{bookingId}}/status"
          }
        }
      ]
    },
    {
      "name": "6. Mensajería Interna (Chat con Cita Aceptada)",
      "item": [
        {
          "name": "33 - Verificar Elegibilidad de Chat",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Chat habilitado tras cita aceptada', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().data.chatEnabled).to.eql(true);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{guestToken}}", "type": "string" }] },
            "method": "GET",
            "url": "{{baseUrl}}/messages/eligibility/{{ownerId}}?chaletId={{chaletId}}"
          }
        },
        {
          "name": "34 - Enviar Mensaje (Huésped -> Anfitrión)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Mensaje enviado y guardado en MongoDB', () => {",
                  "  pm.response.to.have.status(201);",
                  "  pm.expect(pm.response.json().data.content).to.be.a('string');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{guestToken}}", "type": "string" }] },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"recipientId\": \"{{ownerId}}\",\n  \"chaletId\": \"{{chaletId}}\",\n  \"content\": \"Hola, gracias por aceptar la cita. ¿A qué hora nos vemos en el embarcadero?\"\n}"
            },
            "url": "{{baseUrl}}/messages"
          }
        },
        {
          "name": "35 - Responder Mensaje (Anfitrión -> Huésped)",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{hostToken}}", "type": "string" }] },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"recipientId\": \"{{guestId}}\",\n  \"chaletId\": \"{{chaletId}}\",\n  \"content\": \"¡Con gusto! Te espero puntualmente a las 10:00 AM en la entrada principal.\"\n}"
            },
            "url": "{{baseUrl}}/messages"
          }
        },
        {
          "name": "36 - Listar Conversaciones Activas",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{guestToken}}", "type": "string" }] },
            "method": "GET",
            "url": "{{baseUrl}}/messages/conversations"
          }
        },
        {
          "name": "37 - Ver Hilo con Anfitrión (Marca Leídos)",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{guestToken}}", "type": "string" }] },
            "method": "GET",
            "url": "{{baseUrl}}/messages/with/{{ownerId}}?chaletId={{chaletId}}"
          }
        },
        {
          "name": "38 - Contador de Mensajes No Leídos",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{hostToken}}", "type": "string" }] },
            "method": "GET",
            "url": "{{baseUrl}}/messages/unread-count"
          }
        }
      ]
    },
    {
      "name": "7. Limpieza (Opcional)",
      "item": [
        {
          "name": "39 - Eliminar Chalet de Prueba",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Chalet de prueba eliminado', () => pm.response.to.have.status(200));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{hostToken}}", "type": "string" }] },
            "method": "DELETE",
            "url": "{{baseUrl}}/chalets/{{chaletId}}"
          }
        }
      ]
    },
    {
      "name": "8. Uso Manual (Google OAuth, Archivos y Streams SSE)",
      "item": [
        {
          "name": "Google Sign-In (Pegar ID Token de Google)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"credential\": \"PEGA_AQUI_EL_GOOGLE_ID_TOKEN\"\n}"
            },
            "url": "{{baseUrl}}/auth/google"
          }
        },
        {
          "name": "Subir Imágenes (Seleccionar Archivo en Form-Data)",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{hostToken}}", "type": "string" }] },
            "method": "POST",
            "body": {
              "mode": "formdata",
              "formdata": [{ "key": "images", "type": "file", "src": "" }]
            },
            "url": "{{baseUrl}}/uploads/images"
          }
        },
        {
          "name": "SSE Stream Autenticado (Conexión en Vivo)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/events/stream?token={{hostToken}}"
          }
        },
        {
          "name": "SSE Stream Público (Estados de Chalet en Vivo)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/events/public-stream"
          }
        }
      ]
    }
  ]
}
