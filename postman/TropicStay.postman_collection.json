          "name": "01 - Health Check API y MongoDB",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('API saludable y MongoDB conectado', () => {",
                  "  pm.response.to.have.status(200);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.status).to.eql('ok');",
                  "  pm.expect(body.database).to.eql('connected');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/health"
          }
        },
        {
          "name": "02 - Convertir GTQ a USD",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Conversión GTQ -> USD exitosa', () => {",
                  "  pm.response.to.have.status(200);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.success).to.eql(true);",
                  "  pm.expect(body.data.amountUSD).to.be.a('number');",
