{
  "info": {
    "name": "TropicStay - Pruebas guiadas (usar en orden)",
    "description": "Ejecuta las solicitudes 01 a 12 en orden. Consulta docs/GUIA_POSTMAN_PASO_A_PASO.md antes de las que requieren token.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000/api" },
    { "key": "token", "value": "PEGA_AQUI_TU_TOKEN" },
    { "key": "chaletId", "value": "PEGA_AQUI_EL_ID_DEL_CHALET" },
    { "key": "bookingId", "value": "PEGA_AQUI_EL_ID_DE_LA_RESERVA" }
  ],
  "item": [
    { "name": "01 - Salud de API", "request": { "method": "GET", "url": "{{baseUrl}}/health" } },
    { "name": "02 - Ver todos los chalets", "request": { "method": "GET", "url": "{{baseUrl}}/chalets" } },
    { "name": "03 - Filtrar chalets de Sololá", "request": { "method": "GET", "url": "{{baseUrl}}/chalets?department=Solol%C3%A1&guests=4&sort=price-asc" } },
    { "name": "04 - Crear chalet de prueba", "request": { "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] }, "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"title\": \"Chalet de prueba Postman\",\n  \"category\": \"Lago\",\n  \"department\": \"Sololá\",\n  \"municipality\": \"Panajachel\",\n  \"locationName\": \"Panajachel, Sololá\",\n  \"description\": \"Chalet creado para pruebas locales.\",\n  \"pricePerNight\": 1500,\n  \"deposit\": 500,\n  \"cleaningFee\": 150,\n  \"guestsMax\": 4,\n  \"bedrooms\": 2,\n  \"beds\": 3,\n  \"bathrooms\": 2,\n  \"images\": [\"https://images.unsplash.com/photo-1540541338287-41700207dee6?w=1200\"],\n  \"thumbnail\": \"https://images.unsplash.com/photo-1540541338287-41700207dee6?w=1200\",\n  \"amenities\": [\"Wifi de alta velocidad\"],\n  \"rules\": [\"No fumar\"]\n}" }, "url": "{{baseUrl}}/chalets" } },
    { "name": "05 - Ver chalet creado", "request": { "method": "GET", "url": "{{baseUrl}}/chalets/{{chaletId}}" } },
    { "name": "06 - Actualizar chalet", "request": { "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] }, "method": "PUT", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{ \"pricePerNight\": 1650, \"status\": \"disponible\" }" }, "url": "{{baseUrl}}/chalets/{{chaletId}}" } },
    { "name": "07 - Crear reserva", "request": { "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] }, "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"chaletId\": \"{{chaletId}}\",\n  \"guestName\": \"Tu nombre de prueba\",\n  \"guestEmail\": \"tu-correo@ejemplo.com\",\n  \"guestPhone\": \"+50255555555\",\n  \"checkIn\": \"2026-11-20\",\n  \"checkOut\": \"2026-11-23\",\n  \"guestsCount\": 2,\n  \"notes\": \"Prueba desde Postman\"\n}" }, "url": "{{baseUrl}}/bookings" } },
    { "name": "08 - Ver mis reservas", "request": { "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] }, "method": "GET", "url": "{{baseUrl}}/bookings" } },
    { "name": "09 - Cancelar reserva", "request": { "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] }, "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{ \"status\": \"cancelada\" }" }, "url": "{{baseUrl}}/bookings/{{bookingId}}/status" } },
    { "name": "10 - Crear reseña", "request": { "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] }, "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{ \"rating\": 5, \"comment\": \"Reseña de prueba desde Postman.\", \"cleanliness\": 5, \"location\": 5, \"communication\": 5, \"value\": 5 }" }, "url": "{{baseUrl}}/chalets/{{chaletId}}/reviews" } },
    { "name": "11 - Subir imagen", "request": { "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] }, "method": "POST", "body": { "mode": "formdata", "formdata": [{ "key": "images", "type": "file", "src": "" }] }, "url": "{{baseUrl}}/uploads/images" } },
    { "name": "12 - Eliminar chalet de prueba", "request": { "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] }, "method": "DELETE", "url": "{{baseUrl}}/chalets/{{chaletId}}" } }
  ]
}
